---
import { site } from '@data/site';

interface Props {
  planKey: string;
  label: string;
  errorLabel: string;
  loadingLabel?: string;
}

const { planKey, label, errorLabel, loadingLabel = 'Opening Stripe…' } = Astro.props;
const endpoint = `${site.billingApiUrl}/billing/public-checkout-session`;
---

<stripe-checkout-button
  data-endpoint={endpoint}
  data-plan-key={planKey}
  data-error-label={errorLabel}
  data-loading-label={loadingLabel}
>
  <button class="button" type="button">{label}</button>
  <span class="checkout-status" role="status" aria-live="polite"></span>
</stripe-checkout-button>

<script>
  class StripeCheckoutButton extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button');
      const status = this.querySelector('.checkout-status');
      if (!button || button.dataset.ready === 'true') return;
      button.dataset.ready = 'true';
      button.addEventListener('click', async () => {
        const originalLabel = button.textContent || '';
        button.disabled = true;
        button.textContent = this.dataset.loadingLabel || 'Opening Stripe…';
        if (status) status.textContent = '';
        try {
          const response = await fetch(this.dataset.endpoint || '', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ plan_key: this.dataset.planKey }),
          });
          const body = await response.json().catch(() => ({}));
          if (!response.ok || !body.checkout_url) {
            throw new Error(body.detail || 'checkout_unavailable');
          }
          const raw = String(body.checkout_url);
          let parsed;
          try {
            parsed = new URL(raw);
          } catch {
            throw new Error('checkout_unavailable');
          }
          const host = parsed.hostname.toLowerCase();
          const stripeOk =
            host === 'checkout.stripe.com'
            || host === 'billing.stripe.com'
            || host === 'buy.stripe.com'
            || host.endsWith('.stripe.com');
          if (parsed.protocol !== 'https:' || !stripeOk) {
            throw new Error('checkout_unavailable');
          }
          window.location.assign(parsed.toString());
        } catch {
          if (status) status.textContent = this.dataset.errorLabel || 'Checkout unavailable.';
          button.disabled = false;
          button.textContent = originalLabel;
        }
      });
    }
  }

  if (!customElements.get('stripe-checkout-button')) {
    customElements.define('stripe-checkout-button', StripeCheckoutButton);
  }
</script>

<style>
  stripe-checkout-button {
    display: grid;
    gap: 8px;
  }
  stripe-checkout-button .button {
    width: 100%;
  }
  stripe-checkout-button button:disabled {
    cursor: wait;
    opacity: 0.72;
  }
  .checkout-status {
    min-height: 1.2em;
    color: #ff9b9b;
    font-size: 0.82rem;
  }
</style>
