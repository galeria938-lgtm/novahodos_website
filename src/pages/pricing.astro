---
import BaseLayout from '@layouts/BaseLayout.astro';
import PayMethods from '@components/PayMethods.astro';
import { site } from '@data/site';

const nav = site.plans.navigation;
const cal = site.plans.calibration;
---
<BaseLayout
  title="Pricing"
  description="AMI Navigation $19 and Precision Calibration $49. 14-day free trial on the web."
  lang="en"
>
  <section class="section hero compact-hero">
    <p class="eyebrow">Pricing · Web channel</p>
    <h1>Choose how you want to navigate.</h1>
    <p class="lede">Start on the web with 14 days free. Today $0. Then Stripe charges the plan automatically.</p>
    <div class="actions">
      <a class="button" href="#plans">See plans</a>
      <a class="button secondary" href="/ami/experience">See AMI in action</a>
    </div>
  </section>

  <section class="section" id="plans">
    <p class="eyebrow">Plans</p>
    <h2>Navigation or Calibration.</h2>
    <div class="pricing-plans">
      <article class="plan plan-nav">
        <p class="eyebrow">Daily</p>
        <h3>AMI Navigation</h3>
        <p class="plan-price"><strong>${nav.priceMonthly}</strong><span>/ month</span></p>
        <p>Daily route, coach, window, and trajectory. 14-day free trial.</p>
        <a class="button" href={nav.paymentUrl} target="_blank" rel="noopener">Start Navigation — 14 days</a>
        <PayMethods lang="en" />
      </article>
      <article class="plan plan-cal">
        <p class="eyebrow">Precision</p>
        <h3>AMI Precision Calibration</h3>
        <p class="plan-price"><strong>${cal.priceMonthly}</strong><span>/ month</span></p>
        <p>Everything in Navigation plus labs, ratios, and calibration. 14-day free trial.</p>
        <a class="button" href={cal.paymentUrl} target="_blank" rel="noopener">Start Calibration — 14 days</a>
        <PayMethods lang="en" />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .pricing-plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 12px;
  }
  .plan {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 28px 24px;
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .plan-nav {
    border-color: rgba(50, 213, 131, 0.44);
    background: linear-gradient(145deg, rgba(50, 213, 131, 0.13), rgba(255, 255, 255, 0.03));
  }
  .plan-cal {
    border-color: rgba(92, 200, 255, 0.36);
    background: linear-gradient(145deg, rgba(92, 200, 255, 0.11), rgba(255, 255, 255, 0.03));
  }
  .plan h3 { margin: 0; }
  .plan-price { margin: 0; display: flex; align-items: baseline; gap: 8px; }
  .plan-price strong { font-size: 2.6rem; color: #00ff94; line-height: 1; }
  .plan .button { width: 100%; }
  @media (max-width: 800px) {
    .pricing-plans { grid-template-columns: 1fr; }
  }
</style>
