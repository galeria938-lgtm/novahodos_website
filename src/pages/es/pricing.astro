---
import BaseLayout from '@layouts/BaseLayout.astro';
import PayMethods from '@components/PayMethods.astro';
import PlayStoreOption from '@components/PlayStoreOption.astro';
import StripeCheckoutButton from '@components/StripeCheckoutButton.astro';
import { site } from '@data/site';

const nav = site.plans.navigation;
const cal = site.plans.calibration;
---
<BaseLayout
  title="Precios"
  description="AMI Navigation $19 y Precision Calibration $49. Trial 14 días en la web."
  lang="es"
>
  <section class="section hero compact-hero">
    <p class="eyebrow">Precios · Canal web</p>
    <h1>Elige cómo quieres navegar.</h1>
    <p class="lede">Empieza en la web con 14 días gratis. Hoy $0. Después Stripe cobra el plan automáticamente.</p>
    <div class="actions">
      <a class="button" href="#planes">Ver planes</a>
      <a class="button secondary" href="/es/ami/experience">Ver AMI en acción</a>
    </div>
  </section>

  <section class="section" id="planes">
    <p class="eyebrow">Planes</p>
    <h2>Navigation o Calibration.</h2>
    <div class="pricing-plans">
      <article class="plan plan-nav">
        <p class="eyebrow">Diario</p>
        <h3>AMI Navigation</h3>
        <p class="plan-price"><strong>${nav.priceMonthly}</strong><span>/ mes</span></p>
        <p>Ruta diaria, coach, ventana y trayectoria. 14 días gratis.</p>
        <StripeCheckoutButton
          planKey={nav.planKey}
          label="Empezar Navigation — 14 días"
          errorLabel="No se pudo abrir el pago. Inténtalo de nuevo."
          loadingLabel="Abriendo Stripe…"
        />
        <PayMethods lang="es" />
        <PlayStoreOption lang="es" />
      </article>
      <article class="plan plan-cal">
        <p class="eyebrow">Precisión</p>
        <h3>AMI Precision Calibration</h3>
        <p class="plan-price"><strong>${cal.priceMonthly}</strong><span>/ mes</span></p>
        <p>Todo Navigation + labs, ratios y calibración. 14 días gratis.</p>
        <StripeCheckoutButton
          planKey={cal.planKey}
          label="Empezar Calibration — 14 días"
          errorLabel="No se pudo abrir el pago. Inténtalo de nuevo."
          loadingLabel="Abriendo Stripe…"
        />
        <PayMethods lang="es" />
        <PlayStoreOption lang="es" />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .pricing-plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 12px;
  }
  .plan {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 28px 24px;
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .plan-nav {
    border-color: rgba(50, 213, 131, 0.44);
    background: linear-gradient(145deg, rgba(50, 213, 131, 0.13), rgba(255, 255, 255, 0.03));
  }
  .plan-cal {
    border-color: rgba(92, 200, 255, 0.36);
    background: linear-gradient(145deg, rgba(92, 200, 255, 0.11), rgba(255, 255, 255, 0.03));
  }
  .plan h3 { margin: 0; }
  .plan-price { margin: 0; display: flex; align-items: baseline; gap: 8px; }
  .plan-price strong { font-size: 2.6rem; color: #00ff94; line-height: 1; }
  .plan .button { width: 100%; }
  @media (max-width: 800px) {
    .pricing-plans { grid-template-columns: 1fr; }
  }
</style>
