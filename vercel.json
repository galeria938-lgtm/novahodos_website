{
  "redirects": [
    { "source": "/", "destination": "/es/ami", "permanent": false },
    { "source": "/es", "destination": "/es/ami", "permanent": false },
    { "source": "/es/", "destination": "/es/ami", "permanent": false },
    { "source": "/delete-account", "destination": "https://ami-app-tan.vercel.app/delete-account", "permanent": false },
    { "source": "/eliminar-cuenta", "destination": "https://ami-app-tan.vercel.app/eliminar-cuenta", "permanent": false }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
